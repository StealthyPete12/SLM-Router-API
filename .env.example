# Copy to .env and fill in: cp .env.example .env
# .env is gitignored. Never commit real keys.

# The key clients send as `Authorization: Bearer <key>`. Required: without it every
# /v1 endpoint answers 503 (GET /health still works). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ROUTER_API_KEY=

# Which models answer: real (Ollama + your cloud provider), mock (Ollama + a labelled
# mock cloud model, no key needed) or offline (mock local and cloud models: no key,
# no downloads). Mock answers, latency and prices are simulated, never results.
# Read by the Makefile (`make up`, `make demo`).
STACK_MODE=real

# The premium cloud model, reached through its OpenAI-compatible API.
# PREMIUM_MODEL is the provider's current model ID: copy it from the provider's
# docs (nothing is hardcoded). Without PREMIUM_MODEL and PREMIUM_API_KEY, dry runs
# still work but premium chat requests answer 503.
#   OpenAI:    https://api.openai.com/v1
#   Gemini:    https://generativelanguage.googleapis.com/v1beta/openai
#   Anthropic: https://api.anthropic.com/v1   (its OpenAI SDK compatibility layer)
PREMIUM_PROVIDER=openai
PREMIUM_BASE_URL=https://api.openai.com/v1
PREMIUM_MODEL=
PREMIUM_API_KEY=

# Premium prices in USD per million tokens, copied from the provider's pricing page,
# and the date you copied them. Unset, cost and savings are recorded as unknown.
PREMIUM_USD_PER_1M_INPUT=
PREMIUM_USD_PER_1M_OUTPUT=
PREMIUM_PRICED_ON=

# Where the API reaches Ollama. Default: the ollama container.
# Mac (no GPU passthrough in Docker): run Ollama natively and use
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434

# Ollama's context window. Must equal context_window in config/models.yaml.
OLLAMA_CONTEXT_LENGTH=8192

# How long Ollama keeps a model loaded after use. -1 keeps it loaded (use before a demo).
OLLAMA_KEEP_ALIVE=5m

LOG_LEVEL=INFO

# Postgres (request log, feedback, evaluation runs). The API's DATABASE_URL is built
# from these in docker-compose.yml, so use URL-safe characters in the password.
# Local-only defaults; the port is bound to 127.0.0.1. Changing them after the first
# start needs `make reset-data` (the database is initialised once).
POSTGRES_USER=router
POSTGRES_PASSWORD=router-local-dev
POSTGRES_DB=router
# Read-only role Grafana uses for its Postgres data source.
GRAFANA_DB_PASSWORD=grafana-local-dev

# Grafana at http://localhost:3000. Anonymous visitors can view, not edit.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ANONYMOUS_VIEW=true

# Exact-match response cache. docker-compose.yml points the API at its redis service by
# default; set this only to use another Redis. Unset outside Compose = no cache.
# Switch caching off with cache.enabled: false in config/routing.yaml.
# REDIS_URL=redis://redis:6379/0

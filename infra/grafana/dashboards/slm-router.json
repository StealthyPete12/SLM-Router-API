          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.tier AS \"Tier\", count(*) AS \"Votes\", count(*) FILTER (WHERE f.rating = 1) AS \"Thumbs up\", CASE WHEN count(*) >= 5 THEN 100.0 * count(*) FILTER (WHERE f.rating = 1) / count(*) END AS \"Thumbs-up rate\" FROM feedback f JOIN requests r ON r.id = f.request_id WHERE $__timeFilter(f.created_at) AND ('__all__' IN ($client) OR r.client IN ($client)) GROUP BY r.tier ORDER BY r.tier"

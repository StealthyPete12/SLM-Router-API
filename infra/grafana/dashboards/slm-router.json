    {
      "id": 6,
      "type": "stat",
      "title": "Successful requests",
      "description": "Chat completions answered in the time range (dry runs are not stored).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Requests\" FROM requests WHERE $__timeFilter(created_at) AND status = 'ok' AND ('__all__' IN ($client) OR client IN ($client))"
        }

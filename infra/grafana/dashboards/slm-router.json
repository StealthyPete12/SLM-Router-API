    {
      "id": 13,
      "type": "timeseries",
      "title": "p95 latency by tier (Prometheus)",
      "description": "95th percentile of end-to-end latency (fallback included), from the router_latency_seconds histogram over a sliding window, by the tier that answered. Percentiles are interpolated inside histogram buckets. Gaps mean no traffic in the window; the API's counters restart with the container.",
      "datasource": {
        "type": "prometheus",
        "uid": "slm-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "slm-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, tier) (rate(router_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{tier}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "noValue": "No traffic in this time range",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 8,
            "showPoints": "auto",
            "spanNulls": false,
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "local"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "premium"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 16,
        "h": 8
      }
    },
    {
      "id": 14,
      "type": "bargauge",
      "title": "p95 latency by tier (whole time range)",
      "description": "Exact 95th percentile of stored latencies (Postgres percentile_cont) over the whole selected range, by the tier that answered. Use it when traffic came in a burst, such as one demo load. Cache hits are left out: no model ran.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT tier AS \"Tier\", percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms) AS \"p95\" FROM requests WHERE $__timeFilter(created_at) AND status = 'ok' AND ('__all__' IN ($client) OR client IN ($client)) AND latency_ms IS NOT NULL AND NOT cache_hit GROUP BY tier ORDER BY tier"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "min": 0,
          "noValue": "No requests in this time range",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "local"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "premium"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "text",
        "showUnfilled": true,
        "namePlacement": "left",
        "text": {
          "titleSize": 14,
          "valueSize": 16
        },
        "reduceOptions": {
          "calcs": [],
          "fields": "/^p95$/",
          "values": true
        }
      },
      "gridPos": {
        "x": 16,
        "y": 25,

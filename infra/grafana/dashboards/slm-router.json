  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "**Local SLM Router.** Every money value is an *estimate* against an all-premium baseline. Filter by `client` to separate demo-loader traffic from playground or API traffic; rows whose provider is `mock` come from the development mock models (simulated answers and latency, illustrative prices). Load demo data with `make demo`."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Cost savings (estimated USD)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Estimated savings",
      "description": "Sum of baseline cost minus actual cost over successful requests. Estimated: costs use provider-reported tokens priced from config/models.yaml; the baseline prices the same tokens at the premium default, although a cloud model would have written a different number of output tokens. Unknown (not zero) when the premium model has no prices in models.yaml.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(savings_usd) AS \"Estimated savings\" FROM requests WHERE $__timeFilter(created_at) AND status = 'ok' AND ('__all__' IN ($client) OR client IN ($client))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "noValue": "Unknown: no priced requests",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Savings vs all-premium baseline",
      "description": "Estimated savings as a share of what the same requests would have cost on the baseline model. Only requests whose savings are known count, on both sides of the ratio.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * sum(savings_usd) / NULLIF(sum(baseline_cost_usd) FILTER (WHERE savings_usd IS NOT NULL), 0) AS \"Savings vs baseline\" FROM requests WHERE $__timeFilter(created_at) AND status = 'ok' AND ('__all__' IN ($client) OR client IN ($client))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Unknown: no priced requests",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 5
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Estimated spend",
      "description": "What the requests actually cost. Local models cost 0. Estimated: costs use provider-reported tokens priced from config/models.yaml; the baseline prices the same tokens at the premium default, although a cloud model would have written a different number of output tokens.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(cost_usd) AS \"Estimated spend\" FROM requests WHERE $__timeFilter(created_at) AND status = 'ok' AND ('__all__' IN ($client) OR client IN ($client))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "noValue": "Unknown: no priced requests",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",

    {
      "id": 17,
      "type": "stat",
      "title": "Thumbs-up rate",
      "description": "Share of rated answers given a thumbs up (one rating per answer; a changed vote replaces the first). Demo-loader ratings are synthetic fixtures, not user judgements: filter client to exclude them.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE f.rating = 1) / NULLIF(count(*), 0) AS \"Thumbs-up rate\" FROM feedback f JOIN requests r ON r.id = f.request_id WHERE $__timeFilter(f.created_at) AND ('__all__' IN ($client) OR r.client IN ($client))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No feedback in this time range",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 4,
        "h": 9
      }

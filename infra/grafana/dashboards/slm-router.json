      "id": 18,
      "type": "table",
      "title": "Thumbs-up rate by tier",
      "description": "Ratings grouped by the tier that answered (fallbacks count as premium). The rate is shown once a tier has at least 5 votes; below that it is too noisy to read, so only the vote count is shown.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slm-postgres"
      },

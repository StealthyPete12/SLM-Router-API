    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Estimated savings per day",
      "description": "Daily sum of estimated savings, by request date (UTC), for the days inside the time range. Estimated: costs use provider-reported tokens priced from config/models.yaml; the baseline prices the same tokens at the premium default, although a cloud model would have written a different number of output tokens.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(date_trunc('day', created_at), 'YYYY-MM-DD') AS \"Day\", sum(savings_usd) AS \"Estimated savings\" FROM requests WHERE $__timeFilter(created_at) AND status = 'ok' AND ('__all__' IN ($client) OR client IN ($client)) AND savings_usd IS NOT NULL GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "noValue": "No priced requests in this time range",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 1,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "xField": "Day",
        "barWidth": 0.3,
        "showValue": "auto",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 7
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Routing decisions",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Routing mix (% of successful requests)",
      "description": "Local: answered by a local model. Premium: routed to and answered by the cloud model. Fallback: a local model failed (timeout, error or empty answer) and the premium model answered. Cache: answered from the exact-match Redis cache with no model call. The four add up to 100%.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE NOT cache_hit AND fallback_from IS NULL AND tier = 'local') / NULLIF(count(*), 0) AS \"Local\", 100.0 * count(*) FILTER (WHERE NOT cache_hit AND fallback_from IS NULL AND tier = 'premium') / NULLIF(count(*), 0) AS \"Premium\", 100.0 * count(*) FILTER (WHERE NOT cache_hit AND fallback_from IS NOT NULL) / NULLIF(count(*), 0) AS \"Fallback\", 100.0 * count(*) FILTER (WHERE cache_hit) / NULLIF(count(*), 0) AS \"Cache\" FROM requests WHERE $__timeFilter(created_at) AND status = 'ok' AND ('__all__' IN ($client) OR client IN ($client))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "noValue": "No requests in this time range",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Local"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Premium"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fallback"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cache"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c98500"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "text",
        "showUnfilled": true,
        "namePlacement": "left",
        "text": {
          "titleSize": 14,
          "valueSize": 16
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 7,
        "h": 8
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests by route over time",
      "description": "Successful requests per interval, stacked by route.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slm-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, $__interval), count(*) FILTER (WHERE NOT cache_hit AND fallback_from IS NULL AND tier = 'local') AS \"Local\", count(*) FILTER (WHERE NOT cache_hit AND fallback_from IS NULL AND tier = 'premium') AS \"Premium\", count(*) FILTER (WHERE NOT cache_hit AND fallback_from IS NOT NULL) AS \"Fallback\", count(*) FILTER (WHERE cache_hit) AS \"Cache\" FROM requests WHERE $__timeFilter(created_at) AND status = 'ok' AND ('__all__' IN ($client) OR client IN ($client)) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No requests in this time range",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 85,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Local"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Premium"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fallback"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cache"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c98500"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "x": 7,
        "y": 16,
        "w": 9,
        "h": 8
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Why requests went where they did",
      "description": "Routing reason per answering tier. Reasons come from the policy: the score threshold, a caller override, a capability or context-window rule, or privacy.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT reason AS \"Reason\", tier AS \"Tier\", count(*) AS \"Requests\" FROM requests WHERE $__timeFilter(created_at) AND status = 'ok' AND ('__all__' IN ($client) OR client IN ($client)) GROUP BY reason, tier ORDER BY count(*) DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No requests in this time range"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Tier"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Requests"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
